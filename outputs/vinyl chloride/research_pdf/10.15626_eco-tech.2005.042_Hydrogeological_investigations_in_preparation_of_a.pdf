		  	 <article class="obj_article_details">

		
	<h1 class="page_title">
		Hydrogeological investigations in preparation of an in situ bioremediation strategy based on a novel bacterial desulfitobacterium dichloroeliminans strain DCAl
	</h1>

	
	<div class="row">
		<div class="main_entry">

							<section class="item authors">
					<h2 class="pkp_screen_reader">Authors</h2>
					<ul class="authors">
											<li>
							<span class="name">
								Katherine A.  Smith 
							</span>
															<span class="affiliation">
																			<span>Ghent University, Belgium </span>
																				, 																			<span>Ghent University, Belgium</span>
																																					</span>
																																		</li>
											<li>
							<span class="name">
								Alexander  Vandenbohed 
							</span>
															<span class="affiliation">
																			<span>Ghent University, Belgium</span>
																				, 																			<span>Ghent University, Belgium</span>
																																					</span>
																																		</li>
											<li>
							<span class="name">
								Ann  Maes
							</span>
															<span class="affiliation">
																			<span>Ghent University, Belgium</span>
																				, 																			<span>Ghent University, Belgium</span>
																																					</span>
																																		</li>
