<script>
document.addEventListener("DOMContentLoaded", function () {
    const widgets = document.querySelectorAll('.widget-lazy');
    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                let type = entry.target.dataset.widget;
                
                switch(type) {
                    case 'crossmark':
                        loadScript("https://crossmark-cdn.crossref.org/widget/v2.0/widget.js");
                        break;
                    case 'dimensions':
                        loadScript("https://badge.dimensions.ai/badge.js", true);
                        break;
                    case 'plumx':
                        loadScript("//cdn.plu.mx/widget-popup.js");
                        break;
                }

                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });

    widgets.forEach(widget => observer.observe(widget));

    function loadScript(src, async = false) {
        const s = document.createElement('script');
        s.src = src;
        s.async = async;
        document.body.appendChild(s);
    }
});
</script>

