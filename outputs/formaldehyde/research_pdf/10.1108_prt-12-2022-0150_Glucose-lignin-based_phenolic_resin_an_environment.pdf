5ef7","order_by":1,"name":"Xiaowu Gong","email":"","orcid":"","institution":"Shihezi University","correspondingAuthor":false,"prefix":"","firstName":"Xiaowu","middleName":"","lastName":"Gong","suffix":""},{"id":152035707,"identity":"dd603069-b1db-4af4-b7bf-f6923198123e","order_by":2,"name":"Gaoshan Yang","email":"","orcid":"","institution":"Shihezi University","correspondingAuthor":false,"prefix":"","firstName":"Gaoshan","middleName":"","lastName":"Yang","suffix":""},{"id":152035708,"identity":"e9cb73cc-cee9-48a6-95d7-3bb42f82b02a","order_by":3,"name":"Lanli Bai","email":"","orcid":"","institution":"Shihezi University","correspondingAuthor":false,"prefix":"","firstName":"Lanli","middleName":"","lastName":"Bai","suffix":""},{"id":152035709,"identity":"22bc586b-53f2-4490-acbd-024ef867195a","order_by":4,"name":"Jin Huang","email":"","orcid":"","institution":"Southwest University","correspondingAuthor":false,"prefix":"","firstName":"Jin","middleName":"","lastName":"Huang","suffix":""},{"id":152035710,"identity":"882af79c-fbbd-415d-84d5-481c5f968a7f","order_by":5,"name":"Na Zhou","email":"data:image/png;base64,","orcid":"","institution":"Shihezi University","correspondingAuthor":true,"prefix":"","firstName":"Na","middleName":"","lastName":"Zhou","suffix":""},{"id":152035711,"identity":"376321ee-4ced-47d5-bbab-63662cb483c0","order_by":6,"name":"Xin Jia","email":"","orcid":"","institution":"Shihezi University","correspondingAuthor":false,"prefix":"","firstName":"Xin","middleName":"","lastName":"Jia","suffix":""}],"badges":[],"createdAt":"2022-11-13 13:14:16","currentVersionCode":1,"declarations":"","doi":"10.21203/rs.3.rs-2268595/v1","doiUrl":"https://doi.org/10.21203/rs.3.rs-2268595/v1","draftVersion":[],"editorialEvents":[],"editorialNote":"","failedWorkflow":false,"files":[{"id":29145833,"identity":"118b2bd8-911e-4988-b7f1-2bd4fe628dac","added_by":"auto","created_at":"2022-11-16 16:15:28","extension":"png","order_by":1,"title":"Figure 1","display":"","copyAsset":false,"role":"figure","size":77850,"visible":true,"origin":"","legend":"\u003cp\u003eBonding strength and free phenol of PF, LPF, and GLPF\u003c/p\u003e\n\u003cp\u003e(GLPF\u003csup\u003e1\u003c/sup\u003e, GLPF\u003csup\u003e2\u003c/sup\u003e, GLPF\u003csup\u003e3\u003c/sup\u003e and GLPF\u003csup\u003e4\u003c/sup\u003e were 1 h, 30 min, 15 min and 5 min before the end of the condensation respectively)\u003c/p\u003e","description":"","filename":"Figure1.png","url":"https://assets-eu.researchsquare.com/files/rs-2268595/v1/8c6ee14fbacdfd6779cdb781.png"},{"id":29145985,"identity":"591a4147-54c2-48aa-bba3-4c4c9c77b5ae","added_by":"auto","created_at":"2022-11-16 16:23:28","extension":"png","order_by":2,"title":"Figure 2","display":"","copyAsset":false,"role":"figure","size":82612,"visible":true,"origin":"","legend":"\u003cp\u003eFourier transform-infrared spectroscopy (FT-IR) of PF, LPF, and GLPF\u003c/p\u003e","description":"","filename":"Figure2.png","url":"https://assets-eu.researchsquare.com/files/rs-2268595/v1/5b95b8119406eb50aabc4c63.png"},{"id":29145493,"identity":"ec07bf80-6ec1-4b14-b88d-583e44d0bf6f","added_by":"auto","created_at":"2022-11-16 16:07:28","extension":"png","order_by":3,"title":"Figure 3","display":"","copyAsset":false,"role":"figure","size":65195,"visible":true,"origin":"","legend":"\u003cp\u003eTG curves of PF, LPF and GLPF\u003c/p\u003e","description":"","filename":"Figure3.png","url":"https://assets-eu.researchsquare.com/files/rs-2268595/v1/0aaa1fbc4717d7a9fc37e73e.png"},{"id":29145490,"identity":"1515e470-4452-465d-b5a0-56ad73d91ef0","added_by":"auto","created_at":"2022-11-16 16:07:28","extension":"png","order_by":4,"title":"Figure 4","display":"","copyAsset":false,"role":"figure","size":67657,"visible":true,"origin":"","legend":"\u003cp\u003eDSC plots of PF, LPF, and GLPF\u003c/p\u003e","description":"","filename":"Figure4.png","url":"https://assets-eu.researchsquare.com/files/rs-2268595/v1/97415cb2b4cd63caf36625ad.png"},{"id":30112453,"identity":"0753d658-d2bc-4ba7-b16e-e09e0c164446","added_by":"auto","created_at":"2022-12-09 12:14:45","extension":"pdf","order_by":0,"title":"","display":"","copyAsset":false,"role":"manuscript-pdf","size":592443,"visible":true,"origin":"","legend":"","description":"","filename":"manuscript.pdf","url":"https://assets-eu.researchsquare.com/files/rs-2268595/v1/6068e537-81d7-4096-93d2-4f0eb11dda1a.pdf"}],"financialInterests":"No competing interests reported.","formattedTitle":"Glucose-Lignin-Based Phenolic Resin: An Environmentally Friendly Low-Formaldehyde Wood Adhesive","fulltext":[{"header":"1 Introduction","content":"\u003cp\u003eWith the rapid development of social economy and the prosperity of all walks of life, the demand for wood adhesives in civil and industrial fields are increasing (Gong et al. 2020). At present, the wood adhesives widely used in industry include urea formaldehyde resin (UF), phenolic resin (PF), and melamine urea formaldehyde resin (MUF) (Ang et al. 2019). One of the main raw materials used for manufactury resins is formaldehyde, originated from non renewable resources, which is toxic and highly volatile. The emission of formaldehyde during the preparation process will cause harm to the environment and human health (Nielsen et al. 2017). Therefore, the development of low-cost and green resin have attracted much attention.\u003c/p\u003e \u003cp\u003eLignin is the second most abundant natural biomass second to cellulose, which can be used to modify phenolic resins due to the presence of various reactive groups in the structure, such as phenolic hydroxyl group, alcohol hydroxyl group, aldehyde group, methoxyl group etc (Feofilova and Mysyakina \u003cspan citationid=\"CR13\" class=\"CitationRef\"\u003e2016\u003c/span\u003e; Laurichesse and Av\u0026eacute;rous \u003cspan citationid=\"CR27\" class=\"CitationRef\"\u003e2014\u003c/span\u003e; Meng et al. 2019; Gao et al. 2021; Gong et al. 2022). Many researches were carried out to use treated lignin to substitute phenol in resin production(Venkatesagowda and Dekker \u003cspan citationid=\"CR41\" class=\"CitationRef\"\u003e2021\u003c/span\u003e; Zhu et al. 2016; Ai et al. 2021). Gao et al. (2020) used HBr as a trifunctional catalyst for depolymerization, phenolation, and demethylattion of lignin, which were subsequently used to substitute partial phenol and prepare phenolic foams without further purification. Li et al. (2021) used bio-oil obtained from autothermal pyrolysis of kraft lignin to substitute phenol to pepare wood adhesive and the phenol substitution rate can reach more than 80%. Some researchers have devoted another way to study the substitution of lignin for formaldehyde, based on the defect of toxic and highly volatile formaldehyde in phenolic resin raw materials. Foyer et al. (2016) developed a new method to synthesize biobased aldehyde precursor for the preparation of formaldehyde-free resol-type phenolic resins with competitive thermal properties compare to the usual formaldehyde resins. Yang et al. (2021) used lithium aluminum hydride to reduce lignin-derived monomers, including vanillin, methyl vanillate, and syringaldehyde, to generate the corresponding vanillyl and syringic alcohol which could be polymerized to phenolic resin without using formaldehyde. These studies indicated that the modification of lignin to prepare phenolic resins had great potential but it cannot be ignored that many methods require use toxic reagents and harsh high temperature conditions in the pretreatment of lignin (Arefmanesh et al. 2022; Di et al. 2021). The direct substitution formaldehyde by lignin can effectively avoid these problems and simplify the preparation process of lignin-based phenolic resin (LPF). As a kind of macromolecule, lignin has the disadvantage of insufficient crosslinking. Therefore, finding a green, non-toxic, and renewable small molecule to further modify LPF is an innovative work that can make up for the existing defects. Glucose, as a small molecule sugar, has a wide range of sources and abundant reserves in nature. The molecule contains a large number of hydroxyl groups and aldehyde groups (Pramudya et al. 2018; Rapi et al. 2015), which can participate in the reaction of phenol and formaldehyde at the same time. It has been reported that glucose has great potential to substitute formaldehyde(Zhang et al. 2014). Wang et al. (2010) synthesized resin with varying molar ratios of phenol to glucose by using glucose to substitute toxic formaldehyde. Sui et al. (2019) used alkali catalysis to prepare phenol-glucose resin through the nucleophilic addition of phenol and glucose. Cheng et al. (2022) used bio-oil instead of phenol and glucose substitute part of formaldehyde to prepare bio-oil-formaldehyde-glucose (BFG) resins. The direct use of lignin to substitute formaldehyde without pretreatment and glucose modified phenolic resin can not only make the preparation process simpler and greener, but also reduce the production cost, which has great economic significance for industrial utilization.\u003c/p\u003e \u003cp\u003eIn this paper, lignin was directly used to substitute formaldehyde and alkali as catalyst to prepare resol-type phenolic resin. The effects of formaldehyde-to-phenol (F/P) molar ratio, the substitution amount of lignin to formaldehyde, the amount of NaOH, temperature, time, and other factors on the preparation of LPF by substituting formaldehyde were discussed. The optimal experimental condition was determined by orthogonal experiment. And then glucose was used as modifier to prepare glucose-lignin-based phenolic resin (GLPF). The structure of the resin was determined by FT-IR, the solid content, free phenol, bonding strength, and formaldehyde emission of the resin were tested by the Chinese national standard, the thermal properties were analyzed by DSC and TG.\u003c/p\u003e"},{"header":"2 Materials And Methods","content":"\u003cdiv id=\"Sec3\" class=\"Section2\"\u003e \u003ch2\u003e2.1 Materials\u003c/h2\u003e \u003cp\u003ePhenol (AR), anhydrous glucose (99% biotech grade) used in the experiment were purchased from Macklin, formaldehyde solution (37%-40%, AR), urea (AR), NaOH and lignin were purchased from local chemical companies.\u003c/p\u003e \u003c/div\u003e \u003cdiv id=\"Sec4\" class=\"Section2\"\u003e \u003ch2\u003e2.2 Preparation of LPF\u003c/h2\u003e \u003cp\u003eFirst, phenol (7.05g), formaldehyde of correspond molar ratio, different amounts of lignin, NaOH solution (8 mol∙L\u003csup\u003e\u0026minus;\u0026thinsp;1\u003c/sup\u003e) were added into the flask and heated in a water bath. The amount of formaldehyde, lignin, and NaOH solution was 2/3 rds of the total amount. The flask was gradually heated to 65\u0026deg;C in 30 min and maintained at this temperature for 10 min; then, the rest of formaldehyde, lignin, and NaOH solution were added to the flask, heated to corresponding temperature and kept constant for period of time. Finally, certain amount of urea was added 30 min before the end of the condensation, LPF was obtained eventually.\u003c/p\u003e \u003c/div\u003e \u003cdiv id=\"Sec5\" class=\"Section2\"\u003e \u003ch2\u003e2.3 Orthogonal experimental design\u003c/h2\u003e \u003cp\u003eAn orthogonal experiment was designed according to the L\u003csub\u003e25\u003c/sub\u003e (5\u003csup\u003e6\u003c/sup\u003e) table with six variables: F/P molar ratio (A), the substitution amount of lignin to formaldehyde (B), the amount of NaOH (C), temperature (D), time (E), the amount of urea (F). The following were the five values of the variables: A:1:1.4, 1:1.6, 1:1.8, 1:2.0, and 1:2.2; B: 0 wt%, 15 wt%, 30 wt%, 45 wt%, and 60 wt%; C: 3 wt%, 6 wt%, 9 wt%, 12 wt%, and 15 wt%; D: 55\u0026deg;C, 65\u0026deg;C, 75\u0026deg;C, 85\u0026deg;C, and 95\u0026deg;C; E: 1 h, 2 h, 3 h, 4 h, and 5 h; F: 0 wt%, 2.5 wt%, 5 wt%, 7.5 wt%, and 10 wt%. The specific values for the variables were compiled in Table\u0026nbsp;\u003cspan refid=\"Tab1\" class=\"InternalRef\"\u003e1\u003c/span\u003e.\u003c/p\u003e \u003cp\u003e \u003cdiv class=\"gridtable\"\u003e\u003ctable float=\"Yes\" id=\"Tab1\" border=\"1\"\u003e \u003ccaption language=\"En\"\u003e \u003cdiv class=\"CaptionNumber\"\u003eTable 1\u003c/div\u003e \u003cdiv class=\"CaptionContent\"\u003e \u003cp\u003eValues of the variables used for the orthogonal test for LPF synthesis\u003c/p\u003e \u003c/div\u003e \u003c/caption\u003e \u003ccolgroup cols=\"7\"\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c1\" colnum=\"1\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c2\" colnum=\"2\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c3\" colnum=\"3\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c4\" colnum=\"4\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c5\" colnum=\"5\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c6\" colnum=\"6\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c7\" colnum=\"7\"\u003e\u003c/div\u003e \u003cthead\u003e \u003ctr\u003e \u003cth align=\"left\" colname=\"c1\"\u003e\u0026nbsp;\u003c/th\u003e \u003cth align=\"left\" colspan=\"6\" nameend=\"c7\" namest=\"c2\"\u003e \u003cp\u003eFactor\u003c/p\u003e \u003c/th\u003e \u003c/tr\u003e \u003c/thead\u003e \u003ctbody\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003eLevel\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003eA\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003eB\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003eC\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003eD\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003eE\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003eF\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003e1\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003e1:1.4\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003e0\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003e3\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003e55\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003e1\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003e0\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003e2\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003e1:1.6\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003e15\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003e6\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003e65\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003e2\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003e2.5\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003e3\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003e1:1.8\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003e30\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003e9\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003e75\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003e3\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003e5\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003e4\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003e1:2.0\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003e45\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003e12\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003e85\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003e4\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003e7.5\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003ctr\u003e \u003ctd align=\"left\" colname=\"c1\"\u003e \u003cp\u003e5\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c2\"\u003e \u003cp\u003e1:2.2\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c3\"\u003e \u003cp\u003e60\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c4\"\u003e \u003cp\u003e15\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c5\"\u003e \u003cp\u003e95\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c6\"\u003e \u003cp\u003e5\u003c/p\u003e \u003c/td\u003e \u003ctd align=\"left\" colname=\"c7\"\u003e \u003cp\u003e10\u003c/p\u003e \u003c/td\u003e \u003c/tr\u003e \u003c/tbody\u003e \u003c/colgroup\u003e \u003ctfoot\u003e \u003ctr\u003e\u003ctd colspan=\"7\"\u003eA: F/P molar ratio; B: Lignin substitution (wt%); C: the amount of NaOH (wt%); D: Temperature (\u0026deg;C); E: Time (h); F: the amount of urea (wt%)\u003c/td\u003e\u003c/tr\u003e \u003c/tfoot\u003e \u003c/table\u003e\u003c/div\u003e \u003c/p\u003e \u003c/div\u003e \u003cdiv id=\"Sec6\" class=\"Section2\"\u003e \u003ch2\u003e2.4 Preparation of GLPF\u003c/h2\u003e \u003cp\u003eOn the basis of preparation of LPF, 5.29 g of glucose was added at the beginning of the condensation, 3 h, 2 h, 1 h, 30 min, 15 min, and 5 min before the end of the condensation, respectively. GLPF was obtained after the end of the condensation.\u003c/p\u003e \u003c/div\u003e \u003cdiv id=\"Sec7\" class=\"Section2\"\u003e \u003ch2\u003e2.5 Characterization\u003c/h2\u003e \u003cp\u003eThe bonding strength was tested according to GB/T 17657\u0026thinsp;\u0026minus;\u0026thinsp;2013. The poplar veneer was cut to 100mm \u0026times; 25mm \u0026times; 2.5mm, and coated with 100\u0026ndash;120 g/m\u003csup\u003e2\u003c/sup\u003e adhesive. First, plywoods should be cold-pressed for 10 min with 3 MPa, then heated to 180 ℃ for 10 min, and cooled to room temperature. The bonding strength of 7 groups of samples was tested by universal testing machine, and the average value was taken as the final result.\u003c/p\u003e \u003cp\u003eFree phenol, solid content, pH, and formaldehyde emission, were measured by the Chinese national standard methods (GB/T 14074\u0026thinsp;\u0026minus;\u0026thinsp;2006). National standard for various performances were listed in Table\u0026nbsp;\u003cspan refid=\"Tab1\" class=\"InternalRef\"\u003e1\u003c/span\u003e. The structure of PF, LPF, and GLPF were characterized by FT-IR. The curing behavior and thermal stability were evaluated by DSC and TG.\u003c/p\u003e \u003c/div\u003e"},{"header":"3 Results And Discussion","content":"\u003cdiv id=\"Sec9\" class=\"Section2\"\u003e \u003ch2\u003e3.1 Analysis of orthogonal experimental results\u003c/h2\u003e \u003cp\u003eThe effects of F/P molar ratio (A), the substitution amount of lignin to formaldehyde (B), the amount of NaOH (C), temperature (D), time (E), and the amount of urea (F) on the properties of LPF such as free phenol and bonding strength were summarized in Table\u0026nbsp;\u003cspan refid=\"Tab2\" class=\"InternalRef\"\u003e2\u003c/span\u003e. The effects of various factors on LPF following the order: C\u0026thinsp;\u0026gt;\u0026thinsp;B\u0026thinsp;\u0026gt;\u0026thinsp;D\u0026thinsp;\u0026gt;\u0026thinsp;A\u0026thinsp;\u0026gt;\u0026thinsp;E\u0026thinsp;\u0026gt;\u0026thinsp;F. Under the condition of A\u003csub\u003e4\u003c/sub\u003eB\u003csub\u003e2\u003c/sub\u003eC\u003csub\u003e5\u003c/sub\u003eD\u003csub\u003e5\u003c/sub\u003eE\u003csub\u003e4\u003c/sub\u003eF\u003csub\u003e3\u003c/sub\u003e, the optimal experimental condition for preparing LPF were obtained, namely, F/P molar ratio was 1:2.0, the substitution amount of lignin to formaldehyde was 15 wt%, the amount of NaOH was 15 wt%, temperature was 95\u0026deg;C, time was 4 h, the amount of urea was 5 wt%, the free phenol content in the system was 5.60%, and the bonding strength was 0.96 MPa. From the data of bonding strength in Table\u0026nbsp;\u003cspan refid=\"Tab2\" class=\"InternalRef\"\u003e2\u003c/span\u003e, when the substitution amount of lignin to formaldehyde reached 60%, the bonding strength still showed a good result, which may be because the lignin had a certain viscosity, and the addition of lignin into PF can still maintain good bonding strength. Although the performance of LPF was in accordance with the Chinese national standard, compared with other data of the orthogonal experiment, the free phenol and the bonding strength still had the potential to improve under the experimental condition.\u003c/p\u003e \u003cp\u003e \u003cdiv class=\"gridtable\"\u003e\u003ctable float=\"Yes\" id=\"Tab2\" border=\"1\"\u003e \u003ccaption language=\"En\"\u003e \u003cdiv class=\"CaptionNumber\"\u003eTable 2\u003c/div\u003e \u003cdiv class=\"CaptionContent\"\u003e \u003cp\u003eResults of orthogonal experimental and range analysis\u003c/p\u003e \u003c/div\u003e \u003c/caption\u003e \u003ccolgroup cols=\"9\"\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c1\" colnum=\"1\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c2\" colnum=\"2\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=\"c3\" colnum=\"3\"\u003e\u003c/div\u003e \u003cdiv align=\"left\" class=\"colspec\" colname=