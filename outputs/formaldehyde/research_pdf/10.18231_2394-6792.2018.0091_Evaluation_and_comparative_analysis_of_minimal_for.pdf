<script>
  const modal = document.getElementById("citeModal");
  const btn = document.getElementById("citeBtn");
  const span = document.getElementsByClassName("close")[0];

  btn.onclick = () => modal.style.display = "block";
  
    toggleStyle('vancouver');
  
  span.onclick = () => modal.style.display = "none";
  window.onclick = (e) => { if (e.target == modal) modal.style.display = "none"; };

  function toggleStyle(id) {
    const all = document.querySelectorAll('.citation-text');
    all.forEach(el => {
      if (el.id === id) {
        el.style.display = el.style.display === "block" ? "none" : "block";
      } else {
        el.style.display = "none";
      }
    });
  }

 function copyCitation(spanId) {
    const text = document.getElementById(spanId).innerText;
    const button = event.target;

    navigator.clipboard.writeText(text).then(() => {
      const originalText = button.innerText;
      button.innerText = '✅ Copied!';
    //   button.disabled = true;
      setTimeout(() => {
        button.innerText = originalText;
        button.disabled = false;
      }, 2000);
    }).catch(err => {
      console.error('Copy failed:', err);
      button.innerText = '❌ Failed';
      setTimeout(() => {
        button.innerText = '📋 Copy';
      }, 2000);
    });
  }
</script>






