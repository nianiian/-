<div class="pkp_block block_Keywordcloud">
	<span class="title">Keywords</span>
	<div class="content" id='wordcloud'></div>

	<script>
	function randomColor() {
		var cores = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b', '#e377c2', '#7f7f7f', '#bcbd22', '#17becf'];
		return cores[Math.floor(Math.random()*cores.length)];
	}

	document.addEventListener("DOMContentLoaded", function() {
		var keywords = [{"text":"Psoriasis","size":67},{"text":"Acne vulgaris","size":34},{"text":"Melasma","size":32},{"text":"Dermatophytosis","size":31},{"text":"Vitiligo","size":30},{"text":"Dermoscopy","size":23},{"text":"Cutaneous manifestations","size":23},{"text":"Leprosy","size":20},{"text":"Quality of life","size":18},{"text":"Alopecia areata","size":18},{"text":"Treatment","size":18},{"text":"Lichen planus","size":18},{"text":"COVID-19","size":18},{"text":"Androgenetic alopecia","size":17},{"text":"Metabolic syndrome","size":17},{"text":"Hyperpigmentation","size":17},{"text":"HIV","size":17},{"text":"Acne","size":17},{"text":"Dermatology","size":16},{"text":"Skin","size":16},{"text":"Histopathology","size":16},{"text":"Alopecia","size":16},{"text":"Atopic dermatitis","size":15},{"text":"Epidemiology","size":15},{"text":"Diabetes mellitus","size":13},{"text":"Children","size":13},{"text":"PRP","size":13},{"text":"Eczema","size":12},{"text":"Immunotherapy","size":12},{"text":"Prevalence","size":12},{"text":"Dermatoses","size":12},{"text":"Minoxidil","size":11},{"text":"Allergic contact dermatitis","size":11},{"text":"Tinea","size":11},{"text":"Patch test","size":11},{"text":"Xerosis","size":10},{"text":"Urticaria","size":10},{"text":"Warts","size":10},{"text":"Cutaneous","size":9},{"text":"Syphilis","size":9},{"text":"Chronic urticaria","size":9},{"text":"Pemphigus","size":9},{"text":"Fungal infections","size":8},{"text":"Skin diseases","size":8},{"text":"Platelet rich plasma","size":8},{"text":"Tinea corporis","size":8},{"text":"Efficacy","size":8},{"text":"Autologous serum skin test","size":8},{"text":"Topical corticosteroids","size":8},{"text":"Pemphigus vulgaris","size":8}];
		var totalWeight = 0;
		var width = 300;
		var height = 200;
		var transitionDuration = 200;	
		var length_keywords = keywords.length;
		var layout = d3.layout.cloud();

		layout.size([width, height])
			.words(keywords)
			.fontSize(function(d)
			{
				return fontSize(+d.size);
			})
			.on('end', draw);
		
		var svg = d3.select("#wordcloud").append("svg")
			.attr("viewBox", "0 0 " + width + " " + height)	
			.attr("width", '100%');		
		
		function update() {
			var words = layout.words();
			fontSize = d3.scaleLinear().range([16, 34]);
			if (words.length) {
				fontSize.domain([+words[words.length - 1].size || 1, +words[0].size]);
			}
		}
		
		keywords.forEach(function(item,index){totalWeight += item.size;});

		update();

		function draw(words, bounds) {
			var w = layout.size()[0],
                h = layout.size()[1];

			scaling = bounds
                ? Math.min(
                      w / Math.abs(bounds[1].x - w / 2),
                      w / Math.abs(bounds[0].x - w / 2),
                      h / Math.abs(bounds[1].y - h / 2),
                      h / Math.abs(bounds[0].y - h / 2),
                  ) / 2
                : 1;

			svg
			.append("g")
			.attr(
                "transform",
                "translate(" + [w >> 1, h >> 1] + ")scale(" + scaling + ")",
            )
			.selectAll("text")
				.data(words)
			.enter().append("text")
				.style("font-size", function(d) { return d.size + "px"; })
				.style("font-family", 'serif')
				.style("fill", randomColor)
				.style('cursor', 'pointer')
				.style('opacity', 0.7)
				.attr('class', 'keyword')
				.attr("text-anchor", "middle")
				.attr("transform", function(d) {
					return "translate(" + [d.x, d.y] + ")rotate(" + d.rotate + ")";
				}) 
				.text(function(d) { return d.text; })
				.on("click", function(d, i){
					window.location = "https://www.ijord.com/index.php/ijord/search?query=QUERY_SLUG".replace(/QUERY_SLUG/, encodeURIComponent(''+d.text+''));
				})
				.on("mouseover", function(d, i) {
					d3.select(this).transition()
						.duration(transitionDuration)
						.style('font-size',function(d) { return (d.size + 3) + "px"; })
						.style('opacity', 1);
				})
				.on("mouseout", function(d, i) {
					d3.select(this).transition()
						.duration(transitionDuration)
						.style('font-size',function(d) { return d.size + "px"; })
						.style('opacity', 0.7);
				})
				.on('resize', function() { update() });
		}

		layout.start();

	});

	</script>
